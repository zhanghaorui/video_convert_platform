# 环境变量配置模板
# 复制此文件为 .env 并修改相应值

# 应用配置
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=video_convert_platform
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_MAX_POOL_SIZE=20

# RabbitMQ配置
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Redis配置 (可选)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 视频处理配置
VIDEO_TEMP_DIR=/tmp/video-processing
VIDEO_ARCHIVE_ROOT=/data/video-archive
FFMPEG_THREADS=2
FFMPEG_TIMEOUT=300000

# 监控配置
ZIPKIN_BASE_URL=http://localhost:9411
PROMETHEUS_ENABLED=true

# 日志配置
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_FILE_PATH=./logs/application.log

# 安全配置
JWT_SECRET=your_jwt_secret_here
API_RATE_LIMIT=100

# 外部服务配置
CALLBACK_BASE_URL=http://localhost:8080/callback
CALLBACK_TIMEOUT=30000
CALLBACK_RETRY_TIMES=3

# NFS配置 (如果使用)
NFS_SERVER=your_nfs_server
NFS_MOUNT_POINT=/mnt/video-storage

# 业务配置
ENABLE_MD5_CHECK=true
CLEANUP_TEMP_FILES=true
BATCH_SIZE=50
PARALLEL_WORKERS=4
