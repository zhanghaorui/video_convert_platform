# 环境变量配置模板
# 复制此文件为 .env，并按实际环境填充。不要提交真实账号、密码或内网地址。

# 应用配置
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# 数据库配置
# DB_URL 优先级高于 DB_HOST/DB_PORT/DB_NAME。留空时使用下方分项拼接默认 JDBC URL。
DB_URL=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=video_platform
DB_USERNAME=
DB_PASSWORD=
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5

# RabbitMQ 连接配置
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_CONNECTION_TIMEOUT=30000
RABBITMQ_RETRY_ENABLED=true
RABBITMQ_RETRY_INITIAL_INTERVAL=1000
RABBITMQ_RETRY_MAX_ATTEMPTS=3
RABBITMQ_PUBLISHER_CONFIRMS=true
RABBITMQ_PUBLISHER_RETURNS=true

# MQ 业务配置
MQ_ENABLED=false
MQ_VIDEO_TASK_QUEUE=video.task.queue

# NFS/归档配置
NFS_ROOT_PATH=/tmp/video-nfs
NFS_BASE_URL=http://localhost:8080/files

# 视频处理配置
VIDEO_TEMP_DIR=/tmp/video-processing

# 监控配置
ZIPKIN_BASE_URL=http://localhost:9411
PROMETHEUS_ENABLED=true

# 日志配置
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_FILE_PATH=./logs/application.log

# 业务配置
ENABLE_MD5_CHECK=true
CLEANUP_TEMP_FILES=true
BATCH_SIZE=50
PARALLEL_WORKERS=4
