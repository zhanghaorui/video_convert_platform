# Environment variable template for local development.
# Copy to .env if your tooling loads one, but never commit real credentials,
# internal network addresses, private domains, production paths, or patient data.

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database
# DB_URL takes precedence over DB_HOST/DB_PORT/DB_NAME.
DB_URL=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=video_platform_dev
DB_USERNAME=
DB_PASSWORD=
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_CONNECTION_TIMEOUT=30000
RABBITMQ_RETRY_ENABLED=true
RABBITMQ_RETRY_INITIAL_INTERVAL=1000
RABBITMQ_RETRY_MAX_ATTEMPTS=3
RABBITMQ_PUBLISHER_CONFIRMS=true
RABBITMQ_PUBLISHER_RETURNS=true

# MQ
MQ_ENABLED=false
MQ_VIDEO_TASK_QUEUE=video.task.queue

# Archive storage
NFS_ROOT_PATH=/tmp/video-nfs/dev
NFS_BASE_URL=http://localhost:8080/files

# Video processing
VIDEO_TEMP_DIR=/tmp/video-processing
VIDEO_USE_VIDEOTOOLBOX=false

# Monitoring
ZIPKIN_BASE_URL=http://localhost:9411
PROMETHEUS_ENABLED=true

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_FILE_PATH=./logs/application.log

# Business options
WEBHOOK_CALLBACK_ENABLED=false
WEBHOOK_CALLBACK_RETRY_TIMES=3
WEBHOOK_CALLBACK_TIMEOUT_MS=30000
ENABLE_MD5_CHECK=true
CLEANUP_TEMP_FILES=true
BATCH_SIZE=50
PARALLEL_WORKERS=4
